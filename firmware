#define ventilador 9 
#define buzina 3
#define LED 1

void setup() {
  Serial.begin(9600); // Abre a conexão em 9600 baud
  Serial.println("Sistema Inicializado...");
  pinMode(ventilador, OUTPUT);
  pinMode(buzina, OUTPUT);
  pinMode(LED, OUTPUT);
}

void loop() { 
  int leituraSensor = analogRead(A0); // Lê o valor do sensor (TMP)
  Serial.print("Leitura do Sensor: ");
  Serial.println(leituraSensor);
  
  // Controle do Ventilador
  if (leituraSensor >= 164) {
    digitalWrite(ventilador, HIGH); 
  }
  else {
    digitalWrite(ventilador, LOW);
  }

  // Controle de Alerta (LED e Buzina)
  if (leituraSensor >= 207) {
    digitalWrite(LED, HIGH);
    digitalWrite(buzina, HIGH);
  }
  else {
    digitalWrite(LED, LOW);
    digitalWrite(buzina, LOW);
  }

  delay(1000); // Importante porque evita sobrecarga
}
